# Cole TUDO abaixo em: EasyPanel → Projeto → Environment
# Variáveis mágicas EasyPanel: $(PRIMARY_DOMAIN) = domínio do serviço web
#
# Valores reais: copie de deploy/easypanel.env.local (só na sua máquina)
# ou de backend/.env + ajuste FRONTEND_URL e JWT para produção

# ── Supabase ──
DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SUA_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=documentos

# ── JWT (produção — gere strings longas e únicas) ──
JWT_SECRET=[JWT_SECRET_PRODUCAO_64_CHARS]
JWT_REFRESH_SECRET=[JWT_REFRESH_SECRET_PRODUCAO_64_CHARS]
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs (domínio real — NÃO use $(PRIMARY_DOMAIN) no serviço backend) ──
FRONTEND_URL=https://app.absresolve.com.br
API_PUBLIC_URL=https://app.absresolve.com.br
DOMAIN=app.absresolve.com.br

# ── Asaas (produção) ──
# A chave Asaas começa com $ — no EasyPanel use $$ (dois cifrões) para escapar:
# ASAAS_API_KEY=$$aact_prod_000...
ASAAS_API_KEY=[SUA_API_KEY_ASAAS_COM_$$_NO_INICIO_SE_COMECAR_COM_$]
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_MOCK=false
# Token opcional — configure o mesmo valor no painel Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
ASAAS_CNPJ=[CNPJ_EMPRESA]

# ── Opcional ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@absresolve.com.br
SMTP_PASS=
SMTP_FROM=ABS Resolve <contato@absresolve.com.br>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1204471042756196
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v25.0
WHATSAPP_EQUIPE=5592984169936
WHATSAPP_TEMPLATE_PAGAMENTO=jaspers_market_order_confirmation_v1
WHATSAPP_TEMPLATE_LANG=en_US
CARTAO_PARCELAS_SEM_JUROS=3
CARTAO_JUROS_MES=1.99
CRON_LEMBRETES_INTERVAL_MS=900000

# ── Primeiro deploy: true (cria usuários demo). Depois mantenha false para não reescrever dados ──
RUN_SEED=false
