generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  comercial
  operacional
  cliente
  parceiro
}

model User {
  id            String         @id @default(uuid())
  nome          String
  email         String         @unique
  senhaHash     String         @map("senha_hash")
  role          Role           @default(cliente)
  ativo         Boolean        @default(true)
  clienteId     String?        @unique @map("cliente_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  interacoes    Interacao[]
  leadMovimentacoes LeadMovimentacao[]
  auditLogs     AuditLog[]
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  tecnico       Tecnico?
  parceiro          Parceiro?
  resetTokens       PasswordResetToken[]
  iaConhecimentos   IaConhecimento[]

  @@map("users")
}

model IaConhecimento {
  id          String   @id @default(uuid())
  categoria   String   @default("geral")
  servicoSlug String?  @map("servico_slug")
  conteudo    String   @db.Text
  ativo       Boolean  @default(true)
  adminId     String?  @map("admin_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  admin       User?    @relation(fields: [adminId], references: [id])

  @@map("ia_conhecimento")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Cliente {
  id                String      @id @default(uuid())
  tipo              String
  nome              String
  cpf               String?     @unique
  razaoSocial       String?     @map("razao_social")
  nomeFantasia      String?     @map("nome_fantasia")
  cnpj              String?     @unique
  responsavel       String?
  email             String
  telefone          String
  whatsapp          String?
  endereco          Json        @default("{}")
  status            String      @default("ativo")
  /** Origem comercial: whatsapp, site, meta_ads, instagram, google, indicacao, recorrente, outros */
  origem            String?     @default("outros")
  consentimentoLgpd Boolean     @default(false) @map("consentimento_lgpd")
  dataAceite        DateTime?   @map("data_aceite")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  user              User?
  pedidos           Pedido[]
  interacoes        Interacao[]
  pagamentos        Pagamento[]
  documentos        Documento[]
  solicitacoes      SolicitacaoServico[]
  agendamentos      Agendamento[]
  garantias         Garantia[]
  produtosInstalados ProdutoInstalado[]
  ocorrenciasAusencia Int @default(0) @map("ocorrencias_ausencia")
  campanhas           CampanhaCrm[]
  leads               Lead[]
  lancamentosFinanceiros FinLancamento[]
  parceiroId          String?     @map("parceiro_id")
  parceiro            Parceiro?   @relation(fields: [parceiroId], references: [id])

  @@index([telefone])
  @@index([origem])
  @@map("clientes")
}

model Lead {
  id             String    @id @default(uuid())
  nome           String
  /** Nome fantasia (B2B); `nome` pode ser razão social. */
  nomeFantasia   String?   @map("nome_fantasia")
  cpfCnpj        String?   @map("cpf_cnpj")
  telefone       String
  email          String    @default("")
  origem         String
  interesse      String    @default("")
  /** Nome/código da campanha de aquisição (texto livre). */
  campanha       String?
  /** Slug da categoria do catálogo (ex.: ar-condicionado). */
  categoriaInteresse String? @map("categoria_interesse")
  catalogoServicoId  String? @map("catalogo_servico_id")
  /** Segmento B2B (texto livre / select — ex.: Farmácia, Condomínio). */
  segmento       String?
  /** Bairro (prospecção B2B — cabeçalho da planilha). */
  bairro         String?
  /** Ligou? (Sim/Não) — triagem da planilha. */
  ligou          Boolean?
  /** Atendeu? (Sim/Não). */
  atendeu        Boolean?
  /** Contato responsável / decisor (prospecção B2B). */
  contatoNome    String?   @map("contato_nome")
  contatoCargo   String?   @map("contato_cargo")
  /** Telefone/WhatsApp do decisor. */
  contatoTelefone String?  @map("contato_telefone")
  /** E-mail do decisor. */
  contatoEmail   String?   @map("contato_email")
  /** Conseguiu contato do decisor? (Sim/Não). */
  contatoDecisorOk Boolean? @map("contato_decisor_ok")
  cidade         String?
  /** inbound | prospeccao_b2b */
  tipoLead       String    @default("inbound") @map("tipo_lead")
  responsavel    String
  etapa          String    @default("novo_lead")
  /** em_andamento | aguardando_cliente | fechado_ganho | perdido | abandonou_qualificacao */
  statusComercial String   @default("em_andamento") @map("status_comercial")
  valorEstimado  Decimal?  @map("valor_estimado") @db.Decimal(12, 2)
  probabilidade  Int       @default(10)
  prioridade     String    @default("media")
  motivoPerda    String?   @map("motivo_perda")
  observacaoPerda String?  @map("observacao_perda")
  motivoAbandono String?   @map("motivo_abandono")
  observacaoAbandono String? @map("observacao_abandono")
  /** novo | recorrente — usado em CAC (só novos contam como aquisição). */
  tipoCliente    String?   @map("tipo_cliente")
  /** Marcos de evento (competência do lead = createdAt; estes são datas de evento). */
  dataQualificacao DateTime? @map("data_qualificacao")
  dataOrcamento    DateTime? @map("data_orcamento")
  dataFechamento   DateTime? @map("data_fechamento")
  dataPerda        DateTime? @map("data_perda")
  dataAbandono     DateTime? @map("data_abandono")
  dataPrevista   DateTime? @map("data_prevista")
  proximoContato DateTime? @map("proximo_contato")
  dataUltimaInteracao DateTime? @map("data_ultima_interacao")
  proximaAcao    String?   @map("proxima_acao")
  tags           Json      @default("[]")
  observacoes    String?
  clienteId      String?   @map("cliente_id")
  /** Orçamento (SolicitacaoServico) vinculado ao lead. */
  solicitacaoId  String?   @unique @map("solicitacao_id")
  pedidoId       String?   @unique @map("pedido_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  interacoes     Interacao[]
  movimentacoes  LeadMovimentacao[]
  cliente        Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  catalogoServico CatalogoServico? @relation(fields: [catalogoServicoId], references: [id], onDelete: SetNull)
  solicitacao    SolicitacaoServico? @relation("LeadOrcamento", fields: [solicitacaoId], references: [id], onDelete: SetNull)
  solicitacoes   SolicitacaoServico[] @relation("LeadSolicitacoes")
  pedido         Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([etapa])
  @@index([statusComercial])
  @@index([responsavel])
  @@index([proximoContato])
  @@index([origem])
  @@index([campanha])
  @@index([categoriaInteresse])
  @@index([catalogoServicoId])
  @@index([createdAt])
  @@index([dataFechamento])
  @@index([tipoCliente])
  @@index([tipoLead])
  @@index([segmento])
  @@index([bairro])
  @@map("leads")
}

/** Histórico imutável de mudanças de etapa do funil CRM. */
model LeadMovimentacao {
  id            String   @id @default(uuid())
  leadId        String   @map("lead_id")
  etapaAnterior String?  @map("etapa_anterior")
  etapaNova     String   @map("etapa_nova")
  motivo        String?
  observacao    String?
  usuarioId     String?  @map("usuario_id")
  usuarioNome   String?  @map("usuario_nome")
  createdAt     DateTime @default(now()) @map("created_at")
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario       User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([etapaNova])
  @@map("lead_movimentacoes")
}

model Interacao {
  id        String   @id @default(uuid())
  leadId    String?  @map("lead_id")
  clienteId String?  @map("cliente_id")
  tipo      String
  descricao String
  data      DateTime @default(now())
  usuarioId String   @map("usuario_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario   User     @relation(fields: [usuarioId], references: [id])

  @@map("interacoes")
}

model Pedido {
  id           String        @id @default(uuid())
  numero       String        @unique
  clienteId    String        @map("cliente_id")
  servicoId    String?       @map("servico_id")
  valor        Decimal       @db.Decimal(12, 2)
  responsavel  String
  status       String        @default("recebido")
  descricao    String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  servico      Servico?      @relation(fields: [servicoId], references: [id])
  ordemServico OrdemServico?
  pagamentos   Pagamento[]
  solicitacao  SolicitacaoServico?
  agendamentos Agendamento[]
  nfse         Nfse?
  lead         Lead?
  lancamentosFinanceiros FinLancamento[]

  @@map("pedidos")
}

model OrdemServico {
  id                String   @id @default(uuid())
  pedidoId          String   @unique @map("pedido_id")
  etapa             String   @default("solicitacao")
  observacoes       String?
  parceiro          String?
  checklist         Json     @default("{}")
  checklistCompleto Boolean  @default(false) @map("checklist_completo")
  garantiaId        String?     @map("garantia_id")
  tecnicoId         String?     @map("tecnico_id")
  /** Snapshot imutável da geração de materiais (receitas + respostas + linhas). */
  materiaisSnapshot Json?    @map("materiais_snapshot")
  /** True se a lista de materiais da OS foi editada manualmente. */
  materiaisAjusteManual Boolean @default(false) @map("materiais_ajuste_manual")
  /**
   * Confirmações técnicas do admin (não altera respostas comerciais do cliente).
   * Ex.: { respostasConfirmadas: { tipoEquipamentoAr: "inverter" }, historico: [...] }
   */
  dadosTecnicos     Json?    @map("dados_tecnicos")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  pedido            Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tecnico           Tecnico?    @relation(fields: [tecnicoId], references: [id])
  avaliacao         Avaliacao?
  lancamentosFinanceiros FinLancamento[]
  materiais         OsMaterial[]
  pendenciasTecnicas OsPendenciaTecnica[]

  @@map("ordens_servico")
}

model Pagamento {
  id          String    @id @default(uuid())
  clienteId   String    @map("cliente_id")
  pedidoId    String?   @map("pedido_id")
  asaasId     String?   @unique @map("asaas_id")
  valor       Decimal   @db.Decimal(12, 2)
  metodo      String
  status      String    @default("PENDING")
  dueDate     DateTime  @map("due_date")
  paymentDate DateTime? @map("payment_date")
  invoiceUrl  String?   @map("invoice_url")
  pixCode     String?   @map("pix_code")
  createdAt   DateTime  @default(now()) @map("created_at")
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id])
  nfse        Nfse?
  lancamentoFinanceiro FinLancamento?

  @@map("pagamentos")
}

model Nfse {
  id                String    @id @default(uuid())
  pedidoId          String    @unique @map("pedido_id")
  pagamentoId       String?   @unique @map("pagamento_id")
  numero            String?
  codigoVerificacao String?   @map("codigo_verificacao")
  status            String    @default("processando")
  pdfUrl            String?   @map("pdf_url")
  xmlUrl            String?   @map("xml_url")
  documentoId       String?   @map("documento_id")
  providerRef       String?   @map("provider_ref")
  erro              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  pedido            Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pagamento         Pagamento? @relation(fields: [pagamentoId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("nfse")
}

model Servico {
  id          String   @id @default(uuid())
  nome        String
  categoria   String
  descricao   String
  preco       Decimal? @db.Decimal(12, 2)
  parceiro    String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  pedidos     Pedido[]

  @@map("servicos")
}

model Beneficio {
  id        String   @id @default(uuid())
  parceiro  String
  categoria String
  descricao String
  cupom     String?
  cashback  Decimal? @db.Decimal(12, 2)
  desconto  Decimal? @db.Decimal(5, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("beneficios")
}

model Parceiro {
  id              String     @id @default(uuid())
  nome            String
  cnpj            String?    @unique
  email           String
  telefone        String
  categoria       String     @default("vendas")
  codigo          String?    @unique
  comissaoPercent Decimal    @default(10) @map("comissao_percent") @db.Decimal(5, 2)
  userId          String?    @unique @map("user_id")
  ativo           Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  user            User?      @relation(fields: [userId], references: [id])
  clientes        Cliente[]
  comissoes       Comissao[]

  @@map("parceiros")
}

model Comissao {
  id            String    @id @default(uuid())
  parceiroId    String    @map("parceiro_id")
  clienteId     String?   @map("cliente_id")
  pedidoId      String?   @unique @map("pedido_id")
  descricao     String?
  valorVenda    Decimal   @map("valor_venda") @db.Decimal(12, 2)
  percentual    Decimal   @db.Decimal(5, 2)
  valorComissao Decimal   @map("valor_comissao") @db.Decimal(12, 2)
  status        String    @default("pendente")
  pagaEm        DateTime? @map("paga_em")
  createdAt     DateTime  @default(now()) @map("created_at")
  parceiro      Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  @@map("comissoes")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  acao      String
  recurso   String
  recursoId String?  @map("recurso_id")
  detalhes  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notificacao {
  id        String   @id @default(uuid())
  tipo      String
  canal     String
  destino   String
  assunto   String?
  mensagem  String
  status    String   @default("enviada")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notificacoes")
}

model Documento {
  id         String   @id @default(uuid())
  clienteId  String   @map("cliente_id")
  nome       String
  filename   String
  mimetype   String
  tamanho    Int
  url        String
  createdAt  DateTime @default(now()) @map("created_at")
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Movimentacao {
  id               String   @id @default(uuid())
  tipo             String
  categoria        String
  descricao        String
  valor            Decimal? @db.Decimal(12, 2)
  quantidade       Int      @default(1)
  responsavel      String
  produtoEstoqueId String?  @map("produto_estoque_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([produtoEstoqueId])
  @@map("movimentacoes")
}

model CatalogoServico {
  id           String              @id @default(uuid())
  slug         String              @unique
  nome         String
  tipo         String              @default("C")
  pontos       Int                 @default(1)
  categoria    String              @default("eletricista")
  descricao    String?             @db.Text
  precoTexto   String?             @map("preco_texto")
  precoMinimo  Decimal?            @map("preco_minimo") @db.Decimal(12, 2)
  tipoPreco    String              @default("fixo") @map("tipo_preco")
  garantiaDias Int                 @default(90) @map("garantia_dias")
  imagemUrl    String?             @map("imagem_url")
  /** Galeria de imagens (URLs). A capa continua em imagemUrl. */
  imagens      Json                @default("[]")
  ordem        Int                 @default(0)
  upsells      Json                @default("[]")
  relacionados Json                @default("[]")
  ativo        Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  precosFixos  PrecoFixo[]
  solicitacoes SolicitacaoServico[]
  leads        Lead[]
  receitasTecnicas ReceitaTecnica[]

  @@map("catalogo_servicos")
}

model PrecoFixo {
  id        String          @id @default(uuid())
  servicoId String          @map("servico_id")
  chave     String
  label     String
  preco     Decimal         @db.Decimal(12, 2)
  servico   CatalogoServico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, chave])
  @@map("precos_fixos")
}

model ConfigSistema {
  id               String  @id @default("default")
  impostos         Decimal @default(0.14) @db.Decimal(5, 4)
  taxaCartao       Decimal @default(0.04) @map("taxa_cartao") @db.Decimal(5, 4)
  lucro            Decimal @default(0.25) @db.Decimal(5, 4)
  overhead         Decimal @default(0.15) @db.Decimal(5, 4)
  expressValor     Decimal @default(29) @map("express_valor") @db.Decimal(12, 2)
  taxaCancelamento Decimal @default(49) @map("taxa_cancelamento") @db.Decimal(12, 2)
  taxaAusencia     Decimal @default(49) @map("taxa_ausencia") @db.Decimal(12, 2)
  cashbackPercent       Decimal @default(0.10) @map("cashback_percent") @db.Decimal(5, 4)
  bonusIndicacao        Decimal @default(20) @map("bonus_indicacao") @db.Decimal(12, 2)
  garantiaPadraoDias         Int     @default(90) @map("garantia_padrao_dias")
  descontoNovoClientePercent  Decimal  @default(0.10) @map("desconto_novo_cliente_percent") @db.Decimal(5, 4)
  /** Vitrine: venda de peças avulsas (sem instalação). Desligado por padrão. */
  pecasAvulsasAtivas Boolean @default(false) @map("pecas_avulsas_ativas")
  /** Valor mínimo do pedido quando há serviço (visita técnica). */
  minimoCarrinhoServico Decimal @default(150) @map("minimo_carrinho_servico") @db.Decimal(12, 2)

  @@map("config_sistema")
}

model ProdutoEstoque {
  id            String   @id @default(uuid())
  sku           String   @unique
  nome          String
  quantidade    Int      @default(0)
  reservado     Int      @default(0)
  minimo        Int      @default(5)
  critico       Int      @default(2)
  servicoSlug   String?  @map("servico_slug")
  precoUnitario Decimal? @map("preco_unitario") @db.Decimal(12, 2)
  /** Tipo/categoria do material (gourmet, convencional, etc.) */
  tipo          String?
  /** Cor/acabamento */
  cor           String?
  imagemUrl     String?  @map("imagem_url")
  /** Galeria de imagens do produto/SKU (URLs). */
  imagens       Json     @default("[]")
  custo         Decimal? @db.Decimal(12, 2)
  ativo         Boolean  @default(true)
  modeloId      String?  @map("modelo_id")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("produto_estoque")
}

model Tecnico {
  id               String          @id @default(uuid())
  nome             String
  userId           String?         @unique @map("user_id")
  capacidadeDiaria Int             @default(6) @map("capacidade_diaria")
  ativo            Boolean         @default(true)
  agendamentos     Agendamento[]
  ordensServico    OrdemServico[]
  user             User?           @relation(fields: [userId], references: [id])

  @@map("tecnicos")
}

model Agendamento {
  id            String             @id @default(uuid())
  clienteId     String             @map("cliente_id")
  pedidoId      String?            @map("pedido_id")
  solicitacaoId String?            @unique @map("solicitacao_id")
  tecnicoId     String?            @map("tecnico_id")
  data          DateTime
  horarioInicio String             @map("horario_inicio")
  horarioFim    String             @map("horario_fim")
  pontosUsados  Int                @map("pontos_usados")
  express       Boolean            @default(false)
  status        String             @default("confirmado")
  canceladoEm   DateTime?          @map("cancelado_em")
  taxaCobrada   Decimal?           @map("taxa_cobrada") @db.Decimal(12, 2)
  lembrete1dEnviado Boolean          @default(false) @map("lembrete_1d_enviado")
  lembrete2hEnviado Boolean          @default(false) @map("lembrete_2h_enviado")
  createdAt     DateTime           @default(now()) @map("created_at")
  cliente       Cliente            @relation(fields: [clienteId], references: [id])
  pedido        Pedido?            @relation(fields: [pedidoId], references: [id])
  solicitacao   SolicitacaoServico? @relation(fields: [solicitacaoId], references: [id])
  tecnico       Tecnico?           @relation(fields: [tecnicoId], references: [id])

  @@map("agendamentos")
}

model SolicitacaoServico {
  id                  String          @id @default(uuid())
  clienteId           String          @map("cliente_id")
  servicoId           String          @map("servico_id")
  /** Lead comercial que originou este orçamento (se houver). */
  leadId              String?         @map("lead_id")
  tipo                String
  opcoes              Json            @default("{}")
  fotos               Json            @default("[]")
  analiseIa           Json?           @map("analise_ia")
  status              String          @default("rascunho")
  precoBase           Decimal?        @map("preco_base") @db.Decimal(12, 2)
  precoFinal          Decimal?        @map("preco_final") @db.Decimal(12, 2)
  upsellsSelecionados Json            @default("[]") @map("upsells_selecionados")
  nivelComplexidade   Int?            @map("nivel_complexidade")
  confiancaIa         Decimal?        @map("confianca_ia") @db.Decimal(5, 2)
  express             Boolean         @default(false)
  pedidoId            String?         @unique @map("pedido_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  cliente             Cliente         @relation(fields: [clienteId], references: [id])
  servico             CatalogoServico @relation(fields: [servicoId], references: [id])
  lead                Lead?           @relation("LeadSolicitacoes", fields: [leadId], references: [id], onDelete: SetNull)
  leadOrcamentoAtual  Lead?           @relation("LeadOrcamento")
  pedido              Pedido?         @relation(fields: [pedidoId], references: [id])
  agendamento         Agendamento?

  @@index([leadId])
  @@map("solicitacoes_servico")
}

model Garantia {
  id         String   @id @default(uuid())
  numero     String   @unique
  clienteId  String   @map("cliente_id")
  pedidoId   String   @map("pedido_id")
  servico    String
  produto    String
  dataInicio DateTime @map("data_inicio")
  dataFim    DateTime @map("data_fim")
  cliente    Cliente  @relation(fields: [clienteId], references: [id])

  @@map("garantias")
}

model ProdutoInstalado {
  id         String   @id @default(uuid())
  clienteId  String   @map("cliente_id")
  nome       String
  servico    String
  data       DateTime @default(now())
  garantiaId String?  @map("garantia_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id])

  @@map("produtos_instalados")
}

model Avaliacao {
  id             String       @id @default(uuid())
  ordemServicoId String       @unique @map("ordem_servico_id")
  clienteId      String       @map("cliente_id")
  nota           Int
  comentario     String?
  createdAt      DateTime     @default(now()) @map("created_at")
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@map("avaliacoes")
}

model CampanhaCrm {
  id           String   @id @default(uuid())
  clienteId    String   @map("cliente_id")
  tipo         String
  titulo       String
  mensagem     String
  status       String   @default("pendente")
  agendadaPara DateTime @map("agendada_para")
  enviadaEm    DateTime? @map("enviada_em")
  createdAt    DateTime @default(now()) @map("created_at")
  cliente      Cliente  @relation(fields: [clienteId], references: [id])

  @@map("campanhas_crm")
}

model FluxoServicoConfig {
  id                String   @id @default(uuid())
  slug              String   @unique
  perguntas         Json     @default("[]")
  fotosObrigatorias Json     @default("[]") @map("fotos_obrigatorias")
  regrasValidacao   Json     @default("[]") @map("regras_validacao")
  modoPreco                      String   @default("padrao") @map("modo_preco")
  precoBase                      Decimal? @map("preco_base") @db.Decimal(12, 2)
  itensPreco                     Json     @default("[]") @map("itens_preco")
  /** Preço composto: capacidade × metragem (JSON). Só aplica se ativo=true. */
  precoComposto                  Json     @default("{}") @map("preco_composto")
  perguntaQuantidadeId          String?  @map("pergunta_quantidade_id")
  multiplicarBasePorQuantidade   Boolean  @default(true) @map("multiplicar_base_por_quantidade")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("fluxo_servico_config")
}

// ─── Módulo Financeiro ───────────────────────────────────────────────────────

/** receita | custo_direto | despesa_operacional | despesa_financeira | investimento | transferencia */
model FinCategoria {
  id             String             @id @default(uuid())
  tipo           String
  nome           String
  ativo          Boolean            @default(true)
  ordem          Int                @default(0)
  /** Agrupamento DRE: receita_bruta | deducoes | custo_direto | despesa_comercial | despesa_administrativa | despesa_financeira | investimento | transferencia */
  grupoDre       String?            @map("grupo_dre")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  subcategorias  FinSubcategoria[]
  lancamentos    FinLancamento[]
  recorrencias   FinRecorrencia[]

  @@unique([tipo, nome])
  @@index([tipo])
  @@map("fin_categorias")
}

model FinSubcategoria {
  id          String          @id @default(uuid())
  categoriaId String          @map("categoria_id")
  nome        String
  ativo       Boolean         @default(true)
  ordem       Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  categoria   FinCategoria    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  lancamentos FinLancamento[]
  recorrencias FinRecorrencia[]

  @@unique([categoriaId, nome])
  @@map("fin_subcategorias")
}

/** bancaria | digital | caixa | cartao */
model FinConta {
  id           String          @id @default(uuid())
  nome         String
  tipo         String
  saldoInicial Decimal         @default(0) @map("saldo_inicial") @db.Decimal(14, 2)
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  lancamentos  FinLancamento[] @relation("ContaOrigem")
  transferenciasRecebidas FinLancamento[] @relation("ContaDestino")
  recorrencias FinRecorrencia[]
  baixas       FinBaixa[]

  @@map("fin_contas")
}

model FinCentroCusto {
  id           String           @id @default(uuid())
  nome         String           @unique
  ativo        Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  lancamentos  FinLancamento[]
  recorrencias FinRecorrencia[]

  @@map("fin_centros_custo")
}

/**
 * natureza: receita | despesa | transferencia
 * status receita: prevista | a_receber | parcial | recebida | vencida | cancelada | estornada
 * status despesa: prevista | a_pagar | parcial | paga | vencida | cancelada
 */
model FinLancamento {
  id              String           @id @default(uuid())
  natureza        String
  descricao       String
  categoriaId     String?          @map("categoria_id")
  subcategoriaId  String?          @map("subcategoria_id")
  centroCustoId   String?          @map("centro_custo_id")
  clienteId       String?          @map("cliente_id")
  fornecedorNome  String?          @map("fornecedor_nome")
  pedidoId        String?          @map("pedido_id")
  ordemServicoId  String?          @map("ordem_servico_id")
  pagamentoId     String?          @unique @map("pagamento_id")
  /** Valor original da obrigação (não muda com baixas). */
  valor           Decimal          @db.Decimal(14, 2)
  /** Soma do principal já liquidado nas baixas. */
  valorPago       Decimal          @default(0) @map("valor_pago") @db.Decimal(14, 2)
  jurosPago       Decimal          @default(0) @map("juros_pago") @db.Decimal(14, 2)
  multaPaga       Decimal          @default(0) @map("multa_paga") @db.Decimal(14, 2)
  descontoConcedido Decimal        @default(0) @map("desconto_concedido") @db.Decimal(14, 2)
  taxaPaga        Decimal          @default(0) @map("taxa_paga") @db.Decimal(14, 2)
  dataCompetencia DateTime         @map("data_competencia")
  dataVencimento  DateTime?        @map("data_vencimento")
  dataMovimento   DateTime?        @map("data_movimento")
  formaPagamento  String?          @map("forma_pagamento")
  contaId         String?          @map("conta_id")
  contaDestinoId  String?          @map("conta_destino_id")
  status          String
  recorrenciaId   String?          @map("recorrencia_id")
  anexoUrl        String?          @map("anexo_url")
  observacoes     String?
  parcelaNumero   Int?             @map("parcela_numero")
  parcelaTotal    Int?             @map("parcela_total")
  grupoParcelasId String?          @map("grupo_parcelas_id")
  historico       Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  categoria       FinCategoria?    @relation(fields: [categoriaId], references: [id])
  subcategoria    FinSubcategoria? @relation(fields: [subcategoriaId], references: [id])
  centroCusto     FinCentroCusto?  @relation(fields: [centroCustoId], references: [id])
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  pedido          Pedido?          @relation(fields: [pedidoId], references: [id])
  ordemServico    OrdemServico?    @relation(fields: [ordemServicoId], references: [id])
  pagamento       Pagamento?       @relation(fields: [pagamentoId], references: [id])
  conta           FinConta?        @relation("ContaOrigem", fields: [contaId], references: [id])
  contaDestino    FinConta?        @relation("ContaDestino", fields: [contaDestinoId], references: [id])
  recorrencia     FinRecorrencia?  @relation(fields: [recorrenciaId], references: [id])
  baixas          FinBaixa[]

  @@index([natureza, status])
  @@index([dataCompetencia])
  @@index([dataMovimento])
  @@index([dataVencimento])
  @@index([clienteId])
  @@index([pedidoId])
  @@index([grupoParcelasId])
  @@map("fin_lancamentos")
}

/** Baixa individual (pagamento/recebimento/estorno) de um lançamento. */
model FinBaixa {
  id                   String        @id @default(uuid())
  lancamentoId         String        @map("lancamento_id")
  tipo                 String        @default("baixa")
  dataMovimento        DateTime      @map("data_movimento")
  valorPrincipal       Decimal       @map("valor_principal") @db.Decimal(14, 2)
  juros                Decimal       @default(0) @db.Decimal(14, 2)
  multa                Decimal       @default(0) @db.Decimal(14, 2)
  desconto             Decimal       @default(0) @db.Decimal(14, 2)
  taxa                 Decimal       @default(0) @db.Decimal(14, 2)
  /** Valor que efetivamente moveu o caixa (principal+juros+multa-desconto-taxa). */
  valorLiquido         Decimal       @map("valor_liquido") @db.Decimal(14, 2)
  contaId              String?       @map("conta_id")
  formaPagamento       String?       @map("forma_pagamento")
  anexoUrl             String?       @map("anexo_url")
  observacoes          String?
  usuarioId            String?       @map("usuario_id")
  estornado            Boolean       @default(false)
  baixaOrigemId        String?       @map("baixa_origem_id")
  asaasId              String?       @map("asaas_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  lancamento           FinLancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  conta                FinConta?     @relation(fields: [contaId], references: [id])

  @@index([lancamentoId])
  @@index([dataMovimento])
  @@map("fin_baixas")
}

model FinRecorrencia {
  id             String           @id @default(uuid())
  descricao      String
  natureza       String           @default("despesa")
  categoriaId    String?          @map("categoria_id")
  subcategoriaId String?          @map("subcategoria_id")
  centroCustoId  String?          @map("centro_custo_id")
  fornecedorNome String?          @map("fornecedor_nome")
  valor          Decimal          @db.Decimal(14, 2)
  diaDoMes       Int              @map("dia_do_mes")
  contaId        String?          @map("conta_id")
  formaPagamento String?          @map("forma_pagamento")
  ativo          Boolean          @default(true)
  proximaGeracao DateTime         @map("proxima_geracao")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  categoria      FinCategoria?    @relation(fields: [categoriaId], references: [id])
  subcategoria   FinSubcategoria? @relation(fields: [subcategoriaId], references: [id])
  centroCusto    FinCentroCusto?  @relation(fields: [centroCustoId], references: [id])
  conta          FinConta?        @relation(fields: [contaId], references: [id])
  lancamentos    FinLancamento[]

  @@map("fin_recorrencias")
}

/** Receita técnica de materiais vinculada a um serviço do catálogo (Marketplace). */
model ReceitaTecnica {
  id                    String   @id @default(uuid())
  catalogoServicoId     String   @map("catalogo_servico_id")
  nome                  String
  /** materiais | pendencia_tecnica */
  tipo                  String   @default("materiais")
  ativo                 Boolean  @default(true)
  ordem                 Int      @default(0)
  /** Pergunta do fluxo que indica quem fornece o material principal (ID estável). */
  perguntaFornecimentoId String? @map("pergunta_fornecimento_id")
  /** Opções (IDs) que significam "ABS fornece". */
  opcoesAbsFornece      Json     @default("[]") @map("opcoes_abs_fornece")
  /** Campos exclusivos de pendência técnica */
  pendenciaTitulo       String?  @map("pendencia_titulo")
  pendenciaMensagem     String?  @map("pendencia_mensagem") @db.Text
  /** Se true, não gera/separa materiais enquanto pendência estiver aberta. */
  pendenciaBloquearMateriais Boolean @default(true) @map("pendencia_bloquear_materiais")
  /** Pergunta do fluxo que o admin confirma ao resolver (ex.: tipoEquipamentoAr). */
  perguntaResolucaoId   String?  @map("pergunta_resolucao_id")
  /** Opções que o admin pode escolher: [{ id, label }]. */
  opcoesResolucao       Json     @default("[]") @map("opcoes_resolucao")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  catalogoServico       CatalogoServico @relation(fields: [catalogoServicoId], references: [id], onDelete: Cascade)
  condicoes             ReceitaCondicao[]
  materiais             ReceitaMaterial[]
  pendenciasOs          OsPendenciaTecnica[]

  @@index([catalogoServicoId])
  @@index([ativo])
  @@index([tipo])
  @@map("receitas_tecnicas")
}

/** Condição AND: resposta da perguntaId deve estar em opcaoIds. */
model ReceitaCondicao {
  id         String         @id @default(uuid())
  receitaId  String         @map("receita_id")
  perguntaId String         @map("pergunta_id")
  opcaoIds   Json           @default("[]") @map("opcao_ids")
  receita    ReceitaTecnica @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([receitaId])
  @@map("receita_condicoes")
}

/**
 * Material de uma receita.
 * tipoCalculo: metragem | quantidade | fixo | bloco
 * fixoEscopo: por_os | por_unidade (quando tipoCalculo=fixo)
 */
model ReceitaMaterial {
  id                    String         @id @default(uuid())
  receitaId             String         @map("receita_id")
  nome                  String
  especificacao         String?
  bitolaModelo          String?        @map("bitola_modelo")
  unidade               String         @default("unidade")
  tipoCalculo           String         @map("tipo_calculo")
  fator                 Decimal        @default(1) @db.Decimal(12, 4)
  perguntaRefId         String?        @map("pergunta_ref_id")
  blocoX                Decimal?       @map("bloco_x") @db.Decimal(12, 4)
  blocoY                Decimal?       @map("bloco_y") @db.Decimal(12, 4)
  fixoEscopo            String?        @map("fixo_escopo")
  quantidadeFixa        Decimal?       @map("quantidade_fixa") @db.Decimal(12, 4)
  observacaoInterna     String?        @map("observacao_interna") @db.Text
  custoUnitario         Decimal?       @map("custo_unitario") @db.Decimal(12, 2)
  /** Gera mesmo se o cliente fornece o material principal. */
  consumivelOperacional Boolean        @default(false) @map("consumivel_operacional")
  produtoEstoqueId      String?        @map("produto_estoque_id")
  ativo                 Boolean        @default(true)
  ordem                 Int            @default(0)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  receita               ReceitaTecnica @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([receitaId])
  @@map("receita_materiais")
}

/** Linha de material gerada/editada na OS (snapshot operacional). */
model OsMaterial {
  id                 String       @id @default(uuid())
  ordemServicoId     String       @map("ordem_servico_id")
  receitaId          String?      @map("receita_id")
  receitaMaterialId  String?      @map("receita_material_id")
  nome               String
  especificacao      String?
  bitolaModelo       String?      @map("bitola_modelo")
  unidade            String       @default("unidade")
  quantidade         Decimal      @db.Decimal(12, 4)
  custoUnitario      Decimal?     @map("custo_unitario") @db.Decimal(12, 2)
  custoPrevisto      Decimal?     @map("custo_previsto") @db.Decimal(12, 2)
  observacao         String?      @db.Text
  /** automatico | manual | ajustado */
  origem             String       @default("automatico")
  ativo              Boolean      @default(true)
  ordem              Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  ordemServico       OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@map("os_materiais")
}

/** Pendência técnica gerada na OS a partir de uma receita do tipo pendencia_tecnica. */
model OsPendenciaTecnica {
  id                     String   @id @default(uuid())
  ordemServicoId         String   @map("ordem_servico_id")
  receitaId              String?  @map("receita_id")
  titulo                 String
  mensagem               String   @db.Text
  bloquearMateriais      Boolean  @default(true) @map("bloquear_materiais")
  /** pendente | resolvida */
  status                 String   @default("pendente")
  /** Recorte das respostas do cliente que dispararam a pendência (preservadas). */
  respostaOriginalCliente Json?   @map("resposta_original_cliente")
  perguntaResolucaoId    String?  @map("pergunta_resolucao_id")
  opcoesResolucao        Json     @default("[]") @map("opcoes_resolucao")
  resolucaoOpcaoId       String?  @map("resolucao_opcao_id")
  resolucaoOpcaoLabel    String?  @map("resolucao_opcao_label")
  resolvidoEm            DateTime? @map("resolvido_em")
  resolvidoPorUserId     String?  @map("resolvido_por_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  ordemServico           OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  receita                ReceitaTecnica? @relation(fields: [receitaId], references: [id], onDelete: SetNull)

  @@index([ordemServicoId])
  @@index([status])
  @@map("os_pendencias_tecnicas")
}
